generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  ADMINISTRADOR
  RECEPCIONISTA
  MECANICO
}

enum EstadoOT {
  RECIBIDO
  DIAGNOSTICO
  COTIZACION
  APROBADO
  EN_REPARACION
  CONTROL_CALIDAD
  ENTREGADO
}

model Perfil {
  id       String     @id
  nombre   String
  email    String     @unique
  rol      RolUsuario @default(MECANICO)
  activo   Boolean    @default(true)
  creadoEn DateTime   @default(now())

  ordenesAsignadas      OrdenTrabajo[]         @relation("MecanicoAsignado")
  auditorias            RegistroAuditoria[]
  movimientosInventario MovimientoInventario[]
  historialCotizaciones HistorialPrecioCotizacion[]

  @@map("perfiles")
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  rut       String   @unique
  telefono  String?
  email     String?
  creadoEn  DateTime @default(now())

  vehiculos Vehiculo[]
}

model Vehiculo {
  id          String   @id @default(uuid())
  patente     String   @unique
  vin         String?
  marca       String
  modelo      String
  anio        Int?
  kilometraje Int?
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  creadoEn    DateTime @default(now())

  ordenes OrdenTrabajo[]
}

model OrdenTrabajo {
  id                    String    @id @default(uuid())
  vehiculoId            String
  vehiculo              Vehiculo  @relation(fields: [vehiculoId], references: [id])
  mecanicoId            String?
  mecanico              Perfil?   @relation("MecanicoAsignado", fields: [mecanicoId], references: [id])
  fallaReportada        String
  estado                EstadoOT  @default(RECIBIDO)
  horasHombre           Float     @default(0)
  fechaRecepcion        DateTime  @default(now())
  fechaEntrega          DateTime?
  
  // Checklist de recepción (SCRUM-11)
  nivelCombustible      String?
  rayonesCarroceria     String?
  elementosValor        String?
  kilometrajeRecepcion  Int?

  // Diagnóstico técnico y fotos (SCRUM-13, SCRUM-19)
  diagnostico           String?
  trabajoRealizado      String?
  fotosDiagnostico      String[]  @default([])

  creadoEn              DateTime  @default(now())

  detalleRepuestos DetalleOTRepuesto[]
  cotizacion       Cotizacion?
}

model Repuesto {
  id           String   @id @default(uuid())
  codigo       String   @unique
  nombre       String
  stock        Int      @default(0)
  stockMinimo  Int      @default(5)
  precioCompra Float
  precioVenta  Float
  creadoEn     DateTime @default(now())

  usosEnOT    DetalleOTRepuesto[]
  movimientos MovimientoInventario[]

  @@map("repuestos")
}

model DetalleOTRepuesto {
  id             String       @id @default(uuid())
  ordenId        String
  orden          OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repuestoId     String
  repuesto       Repuesto     @relation(fields: [repuestoId], references: [id])
  cantidad       Int
  precioUnitario Float

  @@map("detalles_ot_repuestos")
}

enum TipoMovimientoStock {
  ENTRADA_MANUAL
  SALIDA_OT
  DEVOLUCION_OT
  AJUSTE_FISICO
  IMPORTACION_MASIVA
}

model MovimientoInventario {
  id             String              @id @default(uuid())
  repuestoId     String
  repuesto       Repuesto            @relation(fields: [repuestoId], references: [id], onDelete: Cascade)
  tipo           TipoMovimientoStock
  cantidad       Int
  stockAnterior  Int
  stockNuevo     Int
  motivo         String?
  ordenTrabajoId String?
  usuarioId      String?
  usuario        Perfil?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  creadoEn       DateTime            @default(now())

  @@map("movimientos_inventario")
}

model RegistroAuditoria {
  id         String   @id @default(uuid())
  usuarioId  String?
  usuario    Perfil?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion     String
  entidad    String
  entidadId  String?
  detalles   String?
  ip         String?
  creadoEn   DateTime @default(now())

  @@map("registros_auditoria")
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
}

enum TipoItemCotizacion {
  REPUESTO
  MANO_DE_OBRA
  SERVICIO_EXTERNO
  OTRO
}

model Cotizacion {
  id                String            @id @default(uuid())
  numero            Int               @default(autoincrement())
  ordenTrabajoId    String            @unique
  ordenTrabajo      OrdenTrabajo      @relation(fields: [ordenTrabajoId], references: [id], onDelete: Restrict)
  
  estado            EstadoCotizacion  @default(BORRADOR)
  validezDias       Int               @default(15)
  fechaVencimiento  DateTime?
  observaciones     String?

  // Snapshot Mano de Obra
  horasHombre       Float             @default(0)
  valorHoraHombre   Float             @default(0)
  costoHoraHombre   Float             @default(0)

  // Snapshot Cobro Cliente
  subtotalRepuestos Float             @default(0)
  subtotalManoObra  Float             @default(0)
  subtotalOtros     Float             @default(0)
  descuento         Float             @default(0)
  subtotalNeto      Float             @default(0)
  aplicaIva         Boolean           @default(true)
  iva               Float             @default(0)
  total             Float             @default(0)

  // Snapshot Rentabilidad Interna (Admin)
  costoRepuestos    Float             @default(0)
  costoManoObra     Float             @default(0)
  costoOtros        Float             @default(0)
  costoTotal        Float             @default(0)
  margenNeto        Float             @default(0)
  porcentajeMargen  Float             @default(0)

  items             ItemCotizacion[]
  historialPrecios  HistorialPrecioCotizacion[]

  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt

  @@map("cotizaciones")
}

model ItemCotizacion {
  id              String             @id @default(uuid())
  cotizacionId    String
  cotizacion      Cotizacion         @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  tipo            TipoItemCotizacion @default(REPUESTO)
  referenciaId    String?
  descripcion     String
  cantidad        Float              @default(1)
  precioUnitario  Float
  costoUnitario   Float              @default(0)
  subtotal        Float

  @@map("items_cotizacion")
}

model HistorialPrecioCotizacion {
  id               String      @id @default(uuid())
  cotizacionId     String
  cotizacion       Cotizacion  @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  usuarioId        String?
  usuario          Perfil?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  
  totalAnterior    Float
  subtotalAnterior Float
  totalNuevo       Float
  subtotalNuevo    Float
  
  motivo           String
  detalles         String?     // Snapshot JSON completo de ítems y valores anteriores
  creadoEn         DateTime    @default(now())

  @@map("historial_precios_cotizaciones")
}
